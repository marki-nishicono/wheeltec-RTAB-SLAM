[Unit]
Description=WHEELTEC RGB-D camera capture
Requires=wheeltec-lab-master.service
After=wheeltec-lab-master.service
StartLimitIntervalSec=0
[Service]
ExecStart=/home/wheeltec/wheeltec_slam_ws/src/wheeltec_rtabmap_lab/scripts/start_vehicle.sh camera
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
