<launch>
  <!-- Astra enum 10 = 320x240 at 30 Hz; enum 7 = 640x480 at 30 Hz. -->
  <param name="/camera/driver/color_mode" value="10"/>
  <param name="/camera/driver/depth_mode" value="10"/>
  <param name="/camera/driver/data_skip" value="0"/>
  <include file="$(find astra_camera)/launch/astra.launch">
    <arg name="rgb_processing" value="false"/>
    <arg name="depth_processing" value="false"/>
    <arg name="depth_registered_processing" value="false"/>
    <!-- Mapping frontend uses explicitly scaled factory intrinsics. -->
  </include>
</launch>
